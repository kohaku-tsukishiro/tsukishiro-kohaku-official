---
import BaseLayout from "../layouts/BaseLayout.astro";
import { streamGenres, archivesOf, thumbnailOf } from "../data/streams";

/**
 * 配信 — ジャンル別アーカイブページ
 * トップの活動カードのリンク先。配信が終わったら data/streams.ts の
 * streamArchives に追加し、再生リストができたら playlistUrl を設定する。
 */

/** ジャンルアイコン（トップの活動カードと共通のモチーフ） */
const icons: Record<string, string> = {
  talk: `<svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <circle cx="16" cy="16" r="10" stroke="currentColor" stroke-width="1.8"/>
    <circle cx="11" cy="16" r="1.5" fill="currentColor"/>
    <circle cx="16" cy="16" r="1.5" fill="currentColor"/>
    <circle cx="21" cy="16" r="1.5" fill="currentColor"/>
  </svg>`,
  game: `<svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <path d="M16 4 L28 16 L16 28 L4 16 Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
    <path d="M16 10 L22 16 L16 22 L10 16 Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" opacity="0.5"/>
  </svg>`,
  music: `<svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <path d="M16 6 L26 24 L6 24 Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
    <path d="M16 12 L21 22 L11 22 Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" opacity="0.5"/>
  </svg>`,
  dev: `<svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <rect x="5" y="5" width="22" height="22" rx="3" stroke="currentColor" stroke-width="1.8"/>
    <rect x="10" y="10" width="12" height="12" rx="2" stroke="currentColor" stroke-width="1.4"/>
    <rect x="14" y="14" width="4" height="4" rx="0.5" fill="currentColor" opacity="0.8"/>
  </svg>`,
  shorts: `<svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <rect x="10" y="4" width="12" height="24" rx="3" stroke="currentColor" stroke-width="1.8"/>
    <path d="M14.5 12.5 L19.5 16 L14.5 19.5 Z" fill="currentColor" opacity="0.8"/>
  </svg>`,
};
---

<BaseLayout
  title="配信 | 月白コハク 公式サイト"
  description="月白コハクの配信ジャンル一覧。雑談・ゲーム・歌・企画・自作ツールなど、ジャンル別のアーカイブをまとめています。"
>
  <!-- Banner -->
  <div class="sg-banner">
    <div class="sg-bg circuit-white" aria-hidden="true"></div>
    <div class="sg-frame" aria-hidden="true">
      <span class="sgf-corner-cut"></span>
      <span class="sgf-slash hud-slash hud-slash--white"></span>
      <span class="sgf-chevrons hud-chevrons"><i></i><i></i><i></i><i></i><i></i></span>
    </div>

    <div class="container sg-inner">
      <nav aria-label="パンくず" class="sg-breadcrumb">
        <a href="/">TOP</a>
        <span aria-hidden="true">／</span>
        <span aria-current="page">Streams</span>
      </nav>

      <p class="sg-en">TSUKISHIRO KOHAKU — STREAMS</p>
      <h1 class="sg-title">配信</h1>
      <p class="sg-desc">
        ジャンルごとの配信アーカイブをまとめるページです。<br />
        配信後にアーカイブを順次追加していきます。
      </p>
    </div>
  </div>

  <main id="main">
    <section class="section sg-section">
      <div class="container">
        <div class="sg-grid">
          {streamGenres.map((g) => {
            const archives = archivesOf(g.id);
            const isLive = Boolean(g.playlistUrl) || archives.length > 0;
            return (
              <article id={g.id} class="sg-card doc-panel reveal">
                <div class="sg-head">
                  <span class="mwt-tag">{g.no}</span>
                  <span class="sg-head-slash hud-slash" aria-hidden="true"></span>
                  <span class={`sg-status ${isLive ? "st-live" : "st-coming"}`}>
                    {isLive ? "公開中" : "準備中"}
                  </span>
                </div>
                <div class="sg-body">
                  <span class="sg-chip" set:html={icons[g.id]} />
                  <div class="sg-texts">
                    <p class="sg-name">{g.name}</p>
                    <p class="sg-name-en">{g.en}</p>
                    <p class="sg-detail">{g.detail}</p>
                  </div>
                </div>
                {(archives.length > 0 || g.playlistUrl || !isLive) && (
                  <div class="sg-archive-wrap">
                    {archives.length > 0 && (
                      <ul class="sg-archives">
                        {archives.map((a) => (
                          <li>
                            <a
                              class="sg-archive"
                              href={a.url}
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              <img
                                class="sg-archive-thumb"
                                src={thumbnailOf(a.url)}
                                width="320"
                                height="180"
                                alt=""
                                loading="lazy"
                                decoding="async"
                              />
                              <span class="sg-archive-texts">
                                <time class="sg-archive-date">{a.date}</time>
                                <span class="sg-archive-title">{a.title}</span>
                              </span>
                              <span class="sg-archive-ext" aria-hidden="true">↗</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                    {g.playlistUrl && (
                      <a class="sg-open" href={g.playlistUrl} target="_blank" rel="noopener noreferrer">
                        再生リストを見る ↗
                      </a>
                    )}
                    {!isLive && (
                      <p class="sg-note">
                        アーカイブは配信後に追加予定です。
                      </p>
                    )}
                  </div>
                )}
              </article>
            );
          })}
        </div>

        <div class="mwt-info sg-info reveal">
          <span class="mwt-crescent" aria-hidden="true"></span>
          <span>
            配信アーカイブは配信後に順次ここへ追加していきます。
            最新情報は配信・Xでお知らせします。
            配信で読んでほしい質問・お便りは
            <a href="https://marshmallow-qa.com/1f0c3umyxhp21we" target="_blank" rel="noopener noreferrer">マシュマロ ↗</a>
            から送れます。
          </span>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* ============================================================
     Banner（Projects ページと共通のトーン）
  ============================================================ */
  .sg-banner {
    position: relative;
    padding-top: var(--header-h);
    background: var(--grad-brand);
    overflow: hidden;
  }

  .sg-bg {
    position: absolute;
    inset: 0;
    opacity: 0.16;
    pointer-events: none;
  }

  .sg-frame {
    position: absolute;
    inset: calc(var(--header-h) + 14px) 18px 16px;
    border: 2px solid rgba(255, 255, 255, 0.85);
    border-radius: 10px;
    pointer-events: none;
  }

  .sgf-corner-cut {
    position: absolute;
    top: -2px;
    left: -2px;
    width: 44px;
    height: 44px;
    background: rgba(255, 255, 255, 0.9);
    clip-path: polygon(0 0, 100% 0, 0 100%);
    border-top-left-radius: 8px;
  }

  .sgf-slash {
    position: absolute;
    top: 12px;
    right: 7%;
    width: min(280px, 32%);
  }

  .sgf-chevrons {
    position: absolute;
    left: 24px;
    bottom: 14px;
    color: rgba(255, 255, 255, 0.9);
  }

  .sg-inner {
    position: relative;
    z-index: 1;
    padding-top: 58px;
    padding-bottom: 62px;
  }

  .sg-breadcrumb {
    display: flex;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 34px;
  }

  .sg-breadcrumb a {
    color: #fff;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.5);
    padding-bottom: 1px;
    transition: border-color 0.18s;
  }

  .sg-breadcrumb a:hover,
  .sg-breadcrumb a:focus-visible {
    border-bottom-color: #fff;
  }

  .sg-en {
    margin: 0 0 8px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.34em;
    color: #fff;
    text-shadow: 0 1px 10px rgba(12, 35, 64, 0.3);
  }

  .sg-title {
    margin: 0 0 16px;
    font-size: clamp(1.9rem, 5vw, 2.8rem);
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--c-navy);
    line-height: 1.3;
  }

  .sg-desc {
    margin: 0;
    font-size: 0.96rem;
    color: var(--c-navy);
    line-height: 2.05;
    max-width: 560px;
  }

  /* ============================================================
     Genre cards
  ============================================================ */
  .sg-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 20px;
    margin-bottom: 36px;
  }

  .sg-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    /* 固定ヘッダーの下にアンカーが隠れないようにする */
    scroll-margin-top: calc(var(--header-h) + 24px);
  }

  .sg-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px 10px;
    border-bottom: var(--border-dim);
  }

  .sg-head-slash {
    flex: 1;
    min-width: 14px;
    height: 7px;
    opacity: 0.35;
  }

  .sg-status {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    padding: 3px 9px;
    border-radius: 999px;
    white-space: nowrap;
  }

  .st-live   { color: #10645e; background: rgba(82, 211, 168, 0.16); }
  .st-coming { color: #8a5f1d; background: rgba(217, 162, 72, 0.15); }

  .sg-body {
    display: flex;
    gap: 18px;
    padding: 20px 22px 22px;
    flex: 0 0 auto;
  }

  .sg-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: var(--grad-frame);
    color: #fff;
    box-shadow: 0 6px 16px rgba(43, 124, 217, 0.28);
  }

  .sg-chip :global(svg) {
    width: 28px;
    height: 28px;
  }

  .sg-texts {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }

  .sg-name {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--c-navy);
    letter-spacing: 0.06em;
  }

  .sg-name-en {
    margin: 0 0 8px;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.24em;
    color: var(--c-cyan-text);
  }

  .sg-detail {
    margin: 0;
    font-size: 0.88rem;
    color: var(--c-ink);
    line-height: 1.95;
    flex: 1;
  }

  .sg-note {
    margin: 0;
    font-size: 0.78rem;
    color: #8a5f1d;
    letter-spacing: 0.04em;
    border-top: 1px dashed rgba(217, 162, 72, 0.4);
    padding-top: 10px;
  }

  .sg-archive-wrap {
    padding: 0 22px 22px;
    margin-top: -6px;
  }

  .sg-archives {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(20, 40, 80, 0.12);
  }

  .sg-archive {
    display: grid;
    grid-template-columns: 128px 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 10px 0;
    border-bottom: 1px solid rgba(20, 40, 80, 0.12);
    color: var(--c-ink);
    text-decoration: none;
    font-size: 0.86rem;
    line-height: 1.6;
  }

  .sg-archive:hover .sg-archive-title,
  .sg-archive:focus-visible .sg-archive-title {
    text-decoration: underline;
  }

  .sg-archive-thumb {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid rgba(20, 40, 80, 0.12);
    background: rgba(20, 40, 80, 0.06);
    transition: box-shadow 0.2s, border-color 0.2s;
  }

  .sg-archive:hover .sg-archive-thumb,
  .sg-archive:focus-visible .sg-archive-thumb {
    border-color: rgba(56, 195, 226, 0.7);
    box-shadow: 0 6px 18px rgba(43, 124, 217, 0.18);
  }

  .sg-archive-texts {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .sg-archive-date {
    font-family: var(--font-mono, monospace);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    color: var(--c-muted);
  }

  .sg-archive-title {
    font-weight: 600;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .sg-archive-ext {
    font-size: 0.8rem;
    color: var(--c-blue-deep);
  }

  .sg-open {
    display: inline-block;
    margin-top: 14px;
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--c-blue-deep);
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  .sg-open:hover,
  .sg-open:focus-visible {
    text-decoration: underline;
  }

  .sg-info {
    align-items: center;
  }

  .sg-info a {
    color: var(--c-blue);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .sg-info a:hover,
  .sg-info a:focus-visible {
    color: var(--c-navy);
  }

  /* ============================================================
     Responsive
  ============================================================ */
  @media (max-width: 600px) {
    .sg-frame { inset: calc(var(--header-h) + 8px) 8px 8px; }
    .sg-inner { padding-top: 44px; padding-bottom: 48px; }
    .sg-grid { grid-template-columns: 1fr; }
    .sg-body { flex-direction: column; gap: 14px; }
    .sg-archive { grid-template-columns: 104px 1fr auto; gap: 10px; }
  }
</style>
