---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  publishedProjects,
  projectPhaseMeta,
  projectUrl,
} from "../data/projects";

/**
 * Moonlight White Tiger Project — プロダクト一覧
 * データは src/data/projects.ts で管理。status が "published" のものだけ表示する。
 */
const projects = publishedProjects;
---

<BaseLayout
  title="Projects | 月白コハク 公式サイト"
  description="Moonlight White Tiger Project — 月白コハクが制作するWebアプリ・配信用ツール・開発プロジェクトの一覧。"
>
  <!-- Banner -->
  <div class="pj-banner">
    <div class="pj-bg circuit-white" aria-hidden="true"></div>
    <div class="pj-frame" aria-hidden="true">
      <span class="pjf-corner-cut"></span>
      <span class="pjf-slash hud-slash hud-slash--white"></span>
      <span class="pjf-chevrons hud-chevrons"><i></i><i></i><i></i><i></i><i></i></span>
    </div>

    <div class="container pj-inner">
      <nav aria-label="パンくず" class="pj-breadcrumb">
        <a href="/">TOP</a>
        <span aria-hidden="true">／</span>
        <span aria-current="page">Projects</span>
      </nav>

      <p class="pj-en">MOONLIGHT WHITE TIGER PROJECT</p>
      <h1 class="pj-title">Projects</h1>
      <p class="pj-desc">
        月白コハクが制作しているWebアプリ・ツールの一覧です。<br />
        技術と創作で、配信ももっと楽しく。
      </p>
    </div>
  </div>

  <main id="main">
    <section class="section pj-section">
      <div class="container">
        {projects.length > 0 ? (
          <div class="pj-grid">
            {projects.map((p) => {
              const st = p.phase ? projectPhaseMeta[p.phase] : null;
              return (
                <a class="pj-card doc-panel hud-sweep reveal" href={projectUrl(p)}>
                  <div class="pj-head">
                    <span class="mwt-tag">{p.no}</span>
                    <span class="pj-head-slash hud-slash" aria-hidden="true"></span>
                    {st && <span class={`pj-status ${st.cls}`}>{st.label}</span>}
                  </div>
                  <div class="pj-thumb">
                    {p.thumbnail ? (
                      <img
                        src={p.thumbnail.src}
                        alt={p.thumbnail.alt}
                        width="640"
                        height="400"
                        loading="lazy"
                      />
                    ) : (
                      <span class="pj-thumb-empty" aria-hidden="true">
                        <span class="circuit-white"></span>
                        <span class="mwt-crescent"></span>
                      </span>
                    )}
                  </div>
                  <div class="pj-body">
                    <p class="pj-name">{p.title}</p>
                    <p class="pj-name-en">{p.en}</p>
                    <p class="pj-desc-text">{p.shortDescription}</p>
                    <span class="pj-open">詳しく見る →</span>
                  </div>
                </a>
              );
            })}
          </div>
        ) : (
          <p class="pj-empty doc-panel reveal">
            公開中のプロジェクトはまだありません。
          </p>
        )}

        <div class="mwt-info pj-info reveal">
          <span class="mwt-crescent" aria-hidden="true"></span>
          <span>
            ここに掲載するプロダクトは順次追加されます。最新情報は配信・Xでお知らせします。
          </span>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* ============================================================
     Banner
  ============================================================ */
  .pj-banner {
    position: relative;
    padding-top: var(--header-h);
    background: var(--grad-brand);
    overflow: hidden;
  }

  .pj-bg {
    position: absolute;
    inset: 0;
    opacity: 0.16;
    pointer-events: none;
  }

  .pj-frame {
    position: absolute;
    inset: calc(var(--header-h) + 14px) 18px 16px;
    border: 2px solid rgba(255, 255, 255, 0.85);
    border-radius: 10px;
    pointer-events: none;
  }

  .pjf-corner-cut {
    position: absolute;
    top: -2px;
    left: -2px;
    width: 44px;
    height: 44px;
    background: rgba(255, 255, 255, 0.9);
    clip-path: polygon(0 0, 100% 0, 0 100%);
    border-top-left-radius: 8px;
  }

  .pjf-slash {
    position: absolute;
    top: 12px;
    right: 7%;
    width: min(280px, 32%);
  }

  .pjf-chevrons {
    position: absolute;
    left: 24px;
    bottom: 14px;
    color: rgba(255, 255, 255, 0.9);
  }

  .pj-inner {
    position: relative;
    z-index: 1;
    padding-top: 58px;
    padding-bottom: 62px;
  }

  .pj-breadcrumb {
    display: flex;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 34px;
  }

  .pj-breadcrumb a {
    color: #fff;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.5);
    padding-bottom: 1px;
    transition: border-color 0.18s;
  }

  .pj-breadcrumb a:hover,
  .pj-breadcrumb a:focus-visible {
    border-bottom-color: #fff;
  }

  .pj-en {
    margin: 0 0 8px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.34em;
    color: #fff;
    text-shadow: 0 1px 10px rgba(12, 35, 64, 0.3);
  }

  .pj-title {
    margin: 0 0 16px;
    font-size: clamp(1.9rem, 5vw, 2.8rem);
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--c-navy);
    line-height: 1.3;
  }

  .pj-desc {
    margin: 0;
    font-size: 0.96rem;
    color: var(--c-navy);
    line-height: 2.05;
    max-width: 560px;
  }

  /* ============================================================
     Project cards
  ============================================================ */
  .pj-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
    margin-bottom: 36px;
  }

  .pj-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }

  .pj-card:hover,
  .pj-card:focus-visible {
    border-color: rgba(56, 195, 226, 0.7);
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  .pj-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px 10px;
    border-bottom: var(--border-dim);
  }

  .pj-head-slash {
    flex: 1;
    min-width: 14px;
    height: 7px;
    opacity: 0.35;
  }

  .pj-status {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    padding: 3px 9px;
    border-radius: 999px;
    white-space: nowrap;
  }

  .st-live    { color: #10645e; background: rgba(82, 211, 168, 0.16); }
  .st-coming  { color: #8a5f1d; background: rgba(217, 162, 72, 0.15); }
  .st-dev     { color: var(--c-blue-deep); background: rgba(43, 124, 217, 0.12); }
  .st-planned { color: var(--c-muted); background: rgba(84, 113, 138, 0.12); }

  /* サムネイル（16:10）。未設定時はブランドグラデ＋三日月のプレースホルダ */
  .pj-thumb {
    aspect-ratio: 16 / 10;
    background: var(--grad-frame);
    border-bottom: var(--border-dim);
    overflow: hidden;
  }

  .pj-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pj-thumb-empty {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .pj-thumb-empty .circuit-white {
    position: absolute;
    inset: 0;
    opacity: 0.18;
  }

  .pj-thumb-empty .mwt-crescent {
    width: 34px;
    height: 34px;
    opacity: 0.9;
  }

  .pj-empty {
    margin: 0 0 36px;
    padding: 28px 24px;
    text-align: center;
    font-size: 0.92rem;
    color: var(--c-muted);
  }

  .pj-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px 22px 22px;
    flex: 1;
  }

  .pj-name {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--c-navy);
    letter-spacing: 0.06em;
  }

  .pj-name-en {
    margin: 0 0 8px;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.24em;
    color: var(--c-cyan-text);
  }

  .pj-desc-text {
    margin: 0;
    font-size: 0.88rem;
    color: var(--c-ink);
    line-height: 1.95;
    flex: 1;
  }

  .pj-open {
    margin-top: 14px;
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--c-blue-deep);
    letter-spacing: 0.06em;
  }

  .pj-info {
    align-items: center;
  }

  /* ============================================================
     Responsive
  ============================================================ */
  @media (max-width: 600px) {
    .pj-frame { inset: calc(var(--header-h) + 8px) 8px 8px; }
    .pj-inner { padding-top: 44px; padding-bottom: 48px; }
    .pj-grid { grid-template-columns: 1fr; }
  }
</style>
