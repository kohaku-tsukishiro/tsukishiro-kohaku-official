---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  previewableProjects,
  projectUrl,
  type Project,
} from "../../../data/projects";

/**
 * productionではpublishedかつhasHowToのプロジェクトだけを生成する。
 * DEVではdraftも含め、公開条件を変えずに内容を確認できる。
 */
export function getStaticPaths() {
  return previewableProjects
    .filter((project) => project.hasHowTo)
    .map((project) => ({
      params: { slug: project.slug },
      props: { project },
    }));
}

interface Props {
  project: Project;
}

const { project: p } = Astro.props;
const appUrl = p.appUrl!;
const howToTitle = "けもケット17 購入サポートアプリ｜使い方｜月白コハク";
const howToDescription =
  "けもケット17を便利に回るための非公式購入サポートアプリ。スマホへの追加方法、巡回順、購入リスト、お使い機能などの使い方を紹介します。";

const steps = [
  {
    no: "01",
    title: "行きたいサークルを登録",
    text: "「配置図」または「検索」から行きたいサークルを探し、「予定」へ追加します。",
  },
  {
    no: "02",
    title: "行く順番を整理",
    text: "「行く順番」タブで当日の巡回順を並べ替えます。配置図にも巡回番号が反映されます。",
  },
  {
    no: "03",
    title: "会場では「次に行く」を確認",
    text: "配置図を開けば、次に向かうサークルと場所をすぐ確認できます。「地図で見る」で、その場所を中心に拡大できます。",
    featured: true,
  },
  {
    no: "04",
    title: "買ったら「済み」",
    text: "購入が終わったサークルを「済み」にすると、次のサークルが新しい「次に行く場所」になります。",
  },
];

const faqs = [
  [
    "PCで準備してスマホで使えますか？",
    "自動同期されないため、会場で使用するスマートフォンでの準備をおすすめします。",
  ],
  [
    "ホーム画面に追加しないと使えませんか？",
    "Safari / Chromeからでも利用できます。当日すぐ起動できるため、ホーム画面への追加をおすすめします。",
  ],
  [
    "スマホでこのページを見ています。QRコードは必要ですか？",
    "当日このスマートフォンを使用する場合は不要です。「このスマホでアプリを開く」からそのまま進めます。",
  ],
  [
    "別のスマホを当日使います。",
    "このページの「別のスマホで使う場合」を開き、表示されたQRコードを当日使用するスマートフォンで読み取ってください。",
  ],
  [
    "XやLINEから開きました。",
    "SafariまたはChromeで開き直してからの利用をおすすめします。",
  ],
  [
    "会場で通信できなくても使えますか？",
    "当日前にインターネットへ接続した状態で一度起動しておくことをおすすめします。必要なデータが端末側へ準備され、通信が不安定な場合にも利用しやすくなります。端末環境や通信状況によるため、利用を完全に保証するものではありません。",
  ],
  [
    "公式アプリですか？",
    "月白コハク制作の非公式ファンメイドツールです。けもケット主催・運営とは関係ありません。",
  ],
];
---

<BaseLayout title={howToTitle} description={howToDescription} ogImage="/assets/projects/kemoket-support/og.png">
  <main id="main" class="howto-main">
    <section class="how-hero" aria-labelledby="how-title">
      <div class="how-hero-bg circuit-white" aria-hidden="true"></div>
      <div class="container how-hero-inner">
        <nav aria-label="パンくず" class="how-breadcrumb">
          <a href="/">TOP</a><span aria-hidden="true">／</span>
          <a href="/projects">Projects</a><span aria-hidden="true">／</span>
          <a href={projectUrl(p)}>{p.title}</a><span aria-hidden="true">／</span>
          <span aria-current="page">使い方</span>
        </nav>

        <div class="how-hero-grid">
          <div class="how-hero-copy">
            <div class="how-hero-meta">
              <span class="mwt-chip">PRJ-01 / GUIDE</span>
              <span class="how-unofficial">非公式・ファンメイド</span>
            </div>
            <p class="how-kicker">KEMOKET 17 PURCHASE SUPPORT APP</p>
            <h1 id="how-title">けもケット17<br />購入サポートアプリ</h1>
            <p class="how-lead">
              サークル探しから巡回順、購入チェックまで。<br />
              けもケット当日のお買い物をスマホひとつでサポートします。
            </p>
            <div class="how-actions">
              <a
                class="mwt-btn mwt-btn--navy"
                href={appUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="けもケット17 購入サポートアプリを外部サイトで開く"
              >アプリを開く ↗</a>
              <a class="mwt-btn how-jump" href="#start">スマホで使う準備を見る ↓</a>
            </div>
            <p class="how-by">制作：月白コハク</p>
          </div>

          <figure class="how-hero-visual doc-panel hud-corners">
            <img
              src="/assets/projects/kemoket-support/og.png"
              alt="アプリアイコンと実際の配置図画面を掲載した、けもケット17 購入サポートアプリの紹介画像"
              width="1200"
              height="630"
            />
          </figure>
        </div>
      </div>
    </section>

    <section class="how-section how-first" aria-labelledby="first-title">
      <div class="container">
        <div class="first-card hud-corners">
          <div class="first-icon" aria-hidden="true">!</div>
          <div>
            <p class="eyebrow">最初にお読みください</p>
            <h2 id="first-title">会場に持っていくスマホで<br class="mobile-break" />準備してください</h2>
            <p>
              行く予定・行く順番・購入リスト・メモ・ステータス・お使い関連の情報は、
              <strong>現在使用している端末・ブラウザ側</strong>に保存されます。
            </p>
            <p>
              PCや別のスマートフォンで登録した内容が、当日使うスマートフォンへ自動同期されるアプリではありません。
              <strong>けもケット当日に持っていくスマートフォンでアプリを開き、その端末で準備してください。</strong>
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="how-section" id="start" aria-labelledby="start-title">
      <div class="container">
        <header class="how-section-head">
          <span>NO.01</span>
          <div><h2 id="start-title">スマホで使う準備</h2><p>Start on your phone</p></div>
        </header>

        <div class="desktop-flow doc-panel hud-sweep">
          <div class="device-copy">
            <span class="mwt-tag">PC / LARGE SCREEN</span>
            <h3>当日持っていくスマホで開こう</h3>
            <p>
              アプリのデータは実際に使う端末側に保存されます。
              右のQRコードを、当日会場に持っていくスマートフォンで読み取ってください。
            </p>
            <ol class="mini-flow">
              <li>スマホでQRコードを読み取る</li>
              <li>Safari / Chromeで開く</li>
              <li>必要ならホーム画面へ追加する</li>
              <li>そのスマホで予定・購入リストを準備する</li>
            </ol>
            <a
              class="text-link"
              href={appUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="PCでアプリを開く（外部サイト）"
            >PCでアプリを確認する ↗</a>
          </div>
          <figure class="qr-card">
            <img
              src="/assets/projects/kemoket-support/app-qr.png"
              alt="けもケット17 購入サポートアプリを開くQRコード"
              width="360"
              height="360"
            />
            <figcaption>スマホで読み取って開く</figcaption>
            <code>{appUrl}</code>
          </figure>
        </div>

        <div class="mobile-flow doc-panel hud-corners">
          <img
            class="mobile-app-icon"
            src="/assets/projects/kemoket-support/app-icon.png"
            alt="けもケット17 購入サポートアプリのアイコン"
            width="1254"
            height="1254"
          />
          <span class="mwt-tag">SMARTPHONE</span>
          <h3>このスマホで使いますか？</h3>
          <p>当日このスマートフォンを持っていくなら、このまま準備できます。</p>
          <a
            class="mwt-btn mwt-btn--primary mobile-open"
            href={appUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="このスマホでアプリを外部サイトで開く"
          >このスマホでアプリを開く ↗</a>
          <p class="small-note">ホーム画面に追加しておくと、当日すぐ起動できます。</p>
          <details class="other-device">
            <summary>別のスマホで使う場合</summary>
            <div class="other-device-body">
              <img
                src="/assets/projects/kemoket-support/app-qr.png"
                alt="別のスマートフォンでアプリを開くためのQRコード"
                width="360"
                height="360"
              />
              <p>当日使う別のスマートフォンで読み取ってください。</p>
              <code>{appUrl}</code>
            </div>
          </details>
        </div>

        <aside class="browser-note mwt-info">
          <span aria-hidden="true">↗</span>
          <p>
            <strong>Safari / Chromeでの利用をおすすめします。</strong><br />
            XやLINEなどのアプリ内ブラウザで開いている場合は、SafariまたはChromeで開き直してから準備してください。
          </p>
        </aside>
      </div>
    </section>

    <section class="how-section soft-section" aria-labelledby="home-title">
      <div class="container">
        <header class="how-section-head">
          <span>NO.02</span>
          <div><h2 id="home-title">ホーム画面への追加</h2><p>Add to home screen</p></div>
        </header>
        <p class="section-intro">
          ホーム画面への追加は必須ではありません。通常のSafari / Chromeからも使えますが、当日すぐ起動できるよう追加をおすすめします。
        </p>
        <div class="platform-grid">
          <article class="platform-card doc-panel">
            <span class="platform-label">iPhone / Safari</span>
            <h3>先に追加して、アイコンから準備</h3>
            <ol class="number-steps">
              <li><span>1</span>Safariでアプリを開く</li>
              <li><span>2</span>共有ボタンをタップ</li>
              <li><span>3</span>「ホーム画面に追加」</li>
              <li><span>4</span>「追加」</li>
              <li><span>5</span>追加されたアイコンからアプリを開く</li>
              <li><span>6</span>その状態で予定や購入リストを準備</li>
            </ol>
          </article>
          <article class="platform-card doc-panel">
            <span class="platform-label">Android / Chrome</span>
            <h3>ホーム画面からすぐ起動</h3>
            <ol class="number-steps">
              <li><span>1</span>Chrome等でアプリを開く</li>
              <li><span>2</span>ブラウザのメニューを開く</li>
              <li><span>3</span>「ホーム画面に追加」または「アプリをインストール」</li>
              <li><span>4</span>ホーム画面から起動して準備</li>
            </ol>
            <p class="small-note">機種・OS・ブラウザにより、メニュー名が異なる場合があります。</p>
          </article>
        </div>
        <div class="important-strip">
          <strong>当日ホーム画面から使う予定なら</strong>
          <span>ホーム画面へ追加</span><b aria-hidden="true">→</b>
          <span>アイコンから起動</span><b aria-hidden="true">→</b>
          <span>その状態で準備</span>
        </div>
      </div>
    </section>

    <section class="how-section" aria-labelledby="online-title">
      <div class="container online-card doc-panel hud-corners">
        <div class="online-mark" aria-hidden="true">ON</div>
        <div>
          <header class="how-section-head compact">
            <span>NO.03</span>
            <div><h2 id="online-title">当日前に一度開いておこう</h2><p>Launch once while online</p></div>
          </header>
          <p>
            当日前に、インターネットにつながっている状態で一度アプリを起動してください。
            必要なデータが端末側へ準備され、会場で通信が不安定な場合にも利用しやすくなります。
          </p>
          <p class="small-note">端末環境や通信状況によるため、完全なオフライン動作を保証するものではありません。</p>
        </div>
      </div>
    </section>

    <section class="how-section soft-section" aria-labelledby="steps-title">
      <div class="container">
        <header class="how-section-head">
          <span>NO.04</span>
          <div><h2 id="steps-title">基本の使い方</h2><p>Four simple steps</p></div>
        </header>
        <div class="steps-grid">
          {steps.map((step) => (
            <article class:list={["step-card", "doc-panel", { featured: step.featured }]}>
              <div class="step-no">STEP {step.no}</div>
              <h3>{step.title}</h3>
              {step.featured && (
                <div class="next-feature" aria-label="アプリに表示される次に行く場所の例">
                  <span class="next-label">次に行く</span>
                  <strong>C-03</strong>
                  <span class="next-map">地図で見る ›</span>
                </div>
              )}
              <p>{step.text}</p>
            </article>
          ))}
        </div>
        <div class="screen-feature">
          <figure class="app-screen doc-panel">
            <img
              src="/assets/projects/kemoket-support/og.png"
              alt="現在版のけもケット17 購入サポートアプリ配置図画面を掲載した紹介画像"
              width="1200"
              height="630"
              loading="lazy"
            />
            <figcaption>現在版の実際のアプリ画面。配置図に予定と巡回順を重ねて確認できます。</figcaption>
          </figure>
          <div class="screen-copy">
            <span class="mwt-tag">MAIN FEATURE</span>
            <h3>迷ったら「次に行く」を見る</h3>
            <p>
              行く予定の先頭が常に「次に行く場所」として表示されます。配置番号とサークル名を確認し、
              「地図で見る」を押すと目的地を中心に配置図を確認できます。
            </p>
            <p>
              購入後に「済み」へ変更すると、残っている予定の先頭へ自動で切り替わります。
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="how-section" aria-labelledby="features-title">
      <div class="container">
        <header class="how-section-head">
          <span>NO.05</span>
          <div><h2 id="features-title">便利な機能</h2><p>Useful tools</p></div>
        </header>
        <div class="feature-grid">
          <article class="mini-card"><b>購入リスト</b><p>欲しいもの・価格・個数をサークルごとに整理。</p></article>
          <article class="mini-card"><b>メモ</b><p>頒布物や当日確認したいことを残せます。</p></article>
          <article class="mini-card"><b>あとで</b><p>予定とは分けて、気になるサークルを一時保存。</p></article>
          <article class="mini-card"><b>検索</b><p>サークル名・代表者名・配置番号から探せます。</p></article>
        </div>
      </div>
    </section>

    <section class="how-section errand-section" aria-labelledby="errand-title">
      <div class="container errand-grid">
        <div>
          <header class="how-section-head light">
            <span>NO.06</span>
            <div><h2 id="errand-title">お使い機能</h2><p>Share an errand request</p></div>
          </header>
          <p class="errand-lead">「これも買ってきて」を、サークル情報ごと相手へ渡せます。</p>
          <ol class="errand-flow">
            <li><span>1</span>欲しいものを登録</li>
            <li><span>2</span>お使い依頼を作る</li>
            <li><span>3</span>共有リンクまたはQRコードで渡す</li>
            <li><span>4</span>相手がお使いリストへ追加</li>
          </ol>
          <p class="small-note light-note">共有リンクはLINEやDMなど、普段使っている連絡手段で送れます。</p>
        </div>
        <div class="errand-panel">
          <span>REQUEST FLOW</span>
          <strong>依頼内容</strong><b aria-hidden="true">→</b>
          <strong>共有リンク / QR</strong><b aria-hidden="true">→</b>
          <strong>相手のリスト</strong>
        </div>
      </div>
    </section>

    <section class="how-section" aria-labelledby="check-title">
      <div class="container">
        <header class="how-section-head">
          <span>NO.07</span>
          <div><h2 id="check-title">当日前チェック</h2><p>Before the event</p></div>
        </header>
        <div class="check-list doc-panel">
          {[
            "会場に持っていくスマホで開いた",
            "Safari / Chromeで開いた",
            "ホーム画面に追加した（任意・推奨）",
            "ホーム画面のアイコンから一度起動した",
            "行きたいサークルを登録した",
            "行く順番を確認した",
            "購入リストを確認した",
            "オンライン状態で一度起動した",
          ].map((item, index) => (
            <label><input type="checkbox" /> <span>{item}</span><small>{String(index + 1).padStart(2, "0")}</small></label>
          ))}
        </div>
        <p class="small-note">チェック状態はこのページには保存されません。</p>
      </div>
    </section>

    <section class="how-section soft-section" aria-labelledby="data-title">
      <div class="container">
        <header class="how-section-head">
          <span>NO.08</span>
          <div><h2 id="data-title">データ保存・注意事項</h2><p>Data & important notes</p></div>
        </header>
        <div class="caution-lead doc-panel hud-corners">
          <h3>入力内容は、この端末・このブラウザ内に保存されます</h3>
          <p>サーバーにアカウントデータとして保存し、別端末へ自動同期する仕組みではありません。</p>
        </div>
        <div class="caution-grid">
          <article><span>01</span><h3>別端末へ自動同期されません</h3><p>PCで登録した内容がスマートフォンへ自動で移るわけではありません。当日使う端末で準備してください。</p></article>
          <article><span>02</span><h3>起動方法をそろえて準備</h3><p>当日ホーム画面版を使うなら、ホーム画面のアイコンから起動した状態で予定等を登録してください。</p></article>
          <article><span>03</span><h3>ブラウザデータ削除に注意</h3><p>サイトデータやブラウザの保存データを削除すると、登録内容が消える可能性があります。</p></article>
          <article><span>04</span><h3>プライベートブラウズは非推奨</h3><p>通常のSafari / Chrome、またはホーム画面へ追加したアプリからの利用をおすすめします。</p></article>
          <article><span>05</span><h3>複数ブラウザをまたがない</h3><p>SafariとChromeなど、別ブラウザの保存内容は同じとは限りません。当日使う方法に統一してください。</p></article>
          <article><span>06</span><h3>アプリ内ブラウザを避ける</h3><p>XやLINEから開いた場合は、Safari / Chromeで開き直してから準備してください。</p></article>
        </div>
      </div>
    </section>

    <section class="how-section" aria-labelledby="faq-title">
      <div class="container faq-wrap">
        <header class="how-section-head">
          <span>NO.09</span>
          <div><h2 id="faq-title">よくある質問</h2><p>FAQ</p></div>
        </header>
        <div class="faq-list">
          {faqs.map(([question, answer]) => (
            <details>
              <summary><span>Q</span>{question}</summary>
              <div class="faq-answer"><span>A</span><p>{answer}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="how-section maker-section" aria-labelledby="maker-title">
      <div class="container maker-grid">
        <div>
          <span class="mwt-tag">CREATOR</span>
          <h2 id="maker-title">制作：月白コハク</h2>
          <p>
            本ツールは月白コハクが制作した非公式ファンメイドツールです。<br />
            けもケット主催・運営とは関係ありません。
          </p>
          <div class="maker-links">
            <a class="mwt-btn mwt-btn--navy" href="/">月白コハク公式サイト</a>
            <a
              class="mwt-btn mwt-btn--secondary"
              href="https://x.com/Kohaku_Tsuki905"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="月白コハクのXを外部サイトで開く"
            >月白コハク X ↗</a>
          </div>
        </div>
        <aside class="official-link">
          <span>EVENT OFFICIAL</span>
          <p>イベントの参加案内・最新情報は、けもケット公式サイトをご確認ください。</p>
          <a
            href="https://skypalette.jp/kemoket/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="けもケット公式サイトを外部サイトで開く"
          >けもケット公式サイト ↗</a>
        </aside>
      </div>
    </section>

    <section class="final-cta" aria-labelledby="final-title">
      <div class="final-bg circuit-white" aria-hidden="true"></div>
      <div class="container final-inner">
        <p>READY FOR KEMOKET 17?</p>
