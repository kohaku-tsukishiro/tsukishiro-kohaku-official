---
import BaseLayout from "../layouts/BaseLayout.astro";
import { streamGenres } from "../data/streams";

/**
 * 配信 — ジャンル別アーカイブページ
 * トップの活動カードのリンク先。デビュー後、ジャンルごとの
 * YouTube 再生リストができたら data/streams.ts の playlistUrl を設定する。
 */

/** ジャンルアイコン（トップの活動カードと共通のモチーフ） */
const icons: Record<string, string> = {
  talk: `<svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <circle cx="16" cy="16" r="10" stroke="currentColor" stroke-width="1.8"/>
    <circle cx="11" cy="16" r="1.5" fill="currentColor"/>
    <circle cx="16" cy="16" r="1.5" fill="currentColor"/>
    <circle cx="21" cy="16" r="1.5" fill="currentColor"/>
  </svg>`,
  game: `<svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <path d="M16 4 L28 16 L16 28 L4 16 Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
    <path d="M16 10 L22 16 L16 22 L10 16 Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" opacity="0.5"/>
  </svg>`,
  music: `<svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <path d="M16 6 L26 24 L6 24 Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
    <path d="M16 12 L21 22 L11 22 Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" opacity="0.5"/>
  </svg>`,
  dev: `<svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <rect x="5" y="5" width="22" height="22" rx="3" stroke="currentColor" stroke-width="1.8"/>
    <rect x="10" y="10" width="12" height="12" rx="2" stroke="currentColor" stroke-width="1.4"/>
    <rect x="14" y="14" width="4" height="4" rx="0.5" fill="currentColor" opacity="0.8"/>
  </svg>`,
};
---

<BaseLayout
  title="配信 | 月白コハク 公式サイト"
  description="月白コハクの配信ジャンル一覧。雑談・ゲーム・歌・企画・自作ゲームなど、ジャンル別のアーカイブをまとめています。"
>
  <!-- Banner -->
  <div class="sg-banner">
    <div class="sg-bg circuit-white" aria-hidden="true"></div>
    <div class="sg-frame" aria-hidden="true">
      <span class="sgf-corner-cut"></span>
      <span class="sgf-slash hud-slash hud-slash--white"></span>
      <span class="sgf-chevrons hud-chevrons"><i></i><i></i><i></i><i></i><i></i></span>
    </div>

    <div class="container sg-inner">
      <nav aria-label="パンくず" class="sg-breadcrumb">
        <a href="/">TOP</a>
        <span aria-hidden="true">／</span>
        <span aria-current="page">Streams</span>
      </nav>

      <p class="sg-en">TSUKISHIRO KOHAKU — STREAMS</p>
      <h1 class="sg-title">配信</h1>
      <p class="sg-desc">
        ジャンルごとの配信アーカイブをまとめるページです。<br />
        デビュー後、再生リストを順次追加していきます。
      </p>
    </div>
  </div>

  <main id="main">
    <section class="section sg-section">
      <div class="container">
        <div class="sg-grid">
          {streamGenres.map((g) => {
            const isLive = Boolean(g.playlistUrl);
            return (
              <article id={g.id} class="sg-card doc-panel reveal">
                <div class="sg-head">
                  <span class="mwt-tag">{g.no}</span>
                  <span class="sg-head-slash hud-slash" aria-hidden="true"></span>
                  <span class={`sg-status ${isLive ? "st-live" : "st-coming"}`}>
                    {isLive ? "公開中" : "準備中"}
                  </span>
                </div>
                <div class="sg-body">
                  <span class="sg-chip" set:html={icons[g.id]} />
                  <div class="sg-texts">
                    <p class="sg-name">{g.name}</p>
                    <p class="sg-name-en">{g.en}</p>
                    <p class="sg-detail">{g.detail}</p>
                    {isLive ? (
                      <a class="sg-open" href={g.playlistUrl}>
                        再生リストを見る →
                      </a>
                    ) : (
                      <p class="sg-note">
                        アーカイブはデビュー後に追加予定です。
                      </p>
                    )}
                  </div>
                </div>
              </article>
            );
          })}
        </div>

        <div class="mwt-info sg-info reveal">
          <span class="mwt-crescent" aria-hidden="true"></span>
          <span>
            2026.09.05 のデビュー後、配信アーカイブ・再生リストをここに追加していきます。
            最新情報は配信・Xでお知らせします。
          </span>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* ============================================================
     Banner（Projects ページと共通のトーン）
  ============================================================ */
  .sg-banner {
    position: relative;
    padding-top: var(--header-h);
    background: var(--grad-brand);
    overflow: hidden;
  }

  .sg-bg {
    position: absolute;
    inset: 0;
    opacity: 0.16;
    pointer-events: none;
  }

  .sg-frame {
    position: absolute;
    inset: calc(var(--header-h) + 14px) 18px 16px;
    border: 2px solid rgba(255, 255, 255, 0.85);
    border-radius: 10px;
    pointer-events: none;
  }

  .sgf-corner-cut {
    position: absolute;
    top: -2px;
    left: -2px;
    width: 44px;
    height: 44px;
    background: rgba(255, 255, 255, 0.9);
    clip-path: polygon(0 0, 100% 0, 0 100%);
    border-top-left-radius: 8px;
  }

  .sgf-slash {
    position: absolute;
    top: 12px;
    right: 7%;
    width: min(280px, 32%);
  }

  .sgf-chevrons {
    position: absolute;
    left: 24px;
    bottom: 14px;
    color: rgba(255, 255, 255, 0.9);
  }

  .sg-inner {
    position: relative;
    z-index: 1;
    padding-top: 58px;
    padding-bottom: 62px;
  }

  .sg-breadcrumb {
    display: flex;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 34px;
  }

  .sg-breadcrumb a {
    color: #fff;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.5);
    padding-bottom: 1px;
    transition: border-color 0.18s;
  }

  .sg-breadcrumb a:hover,
  .sg-breadcrumb a:focus-visible {
    border-bottom-color: #fff;
  }

  .sg-en {
    margin: 0 0 8px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.34em;
    color: #fff;
    text-shadow: 0 1px 10px rgba(12, 35, 64, 0.3);
  }

  .sg-title {
    margin: 0 0 16px;
    font-size: clamp(1.9rem, 5vw, 2.8rem);
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--c-navy);
    line-height: 1.3;
  }

  .sg-desc {
    margin: 0;
    font-size: 0.96rem;
    color: var(--c-navy);
    line-height: 2.05;
    max-width: 560px;
  }

  /* ============================================================
     Genre cards
  ============================================================ */
  .sg-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 20px;
    margin-bottom: 36px;
  }

  .sg-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    /* 固定ヘッダーの下にアンカーが隠れないようにする */
    scroll-margin-top: calc(var(--header-h) + 24px);
  }

  .sg-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px 10px;
    border-bottom: var(--border-dim);
  }

  .sg-head-slash {
    flex: 1;
    min-width: 14px;
    height: 7px;
    opacity: 0.35;
  }

  .sg-status {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    padding: 3px 9px;
    border-radius: 999px;
    white-space: nowrap;
  }

  .st-live   { color: #10645e; background: rgba(82, 211, 168, 0.16); }
  .st-coming { color: #8a5f1d; background: rgba(217, 162, 72, 0.15); }

  .sg-body {
    display: flex;
    gap: 18px;
    padding: 20px 22px 22px;
    flex: 1;
  }

  .sg-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: var(--grad-frame);
    color: #fff;
    box-shadow: 0 6px 16px rgba(43, 124, 217, 0.28);
  }

  .sg-chip :global(svg) {
    width: 28px;
    height: 28px;
  }

  .sg-texts {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }

  .sg-name {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--c-navy);
    letter-spacing: 0.06em;
  }

  .sg-name-en {
    margin: 0 0 8px;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.24em;
    color: var(--c-cyan-text);
  }

  .sg-detail {
    margin: 0;
    font-size: 0.88rem;
    color: var(--c-ink);
    line-height: 1.95;
    flex: 1;
  }

  .sg-note {
    margin: 12px 0 0;
    font-size: 0.78rem;
    color: #8a5f1d;
    letter-spacing: 0.04em;
    border-top: 1px dashed rgba(217, 162, 72, 0.4);
    padding-top: 10px;
  }

  .sg-open {
    margin-top: 14px;
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--c-blue-deep);
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  .sg-open:hover,
  .sg-open:focus-visible {
    text-decoration: underline;
  }

  .sg-info {
    align-items: center;
  }

  /* ============================================================
     Responsive
  ============================================================ */
  @media (max-width: 600px) {
    .sg-frame { inset: calc(var(--header-h) + 8px) 8px 8px; }
    .sg-inner { padding-top: 44px; padding-bottom: 48px; }
    .sg-grid { grid-template-columns: 1fr; }
    .sg-body { flex-direction: column; gap: 14px; }
  }
</style>
